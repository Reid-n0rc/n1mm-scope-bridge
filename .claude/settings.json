{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge * --auto*)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh issue *)",
      "Bash(python scripts/ready_to_merge.py *)",
      "Bash(python scripts/check_overlap.py *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Bash(gh release *)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh issue edit *--add-label*plan-approved*)",
      "Bash(gh issue create *--label*plan-approved*)",
      "Bash(gh issue create * -l *plan-approved*)",
      "Bash(git push --tags*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method=delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.sh"
          }
        ]
      }
    ]
  }
}
