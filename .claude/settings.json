{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh issue *)",
      "Bash(python scripts/ready_to_merge.py *)",
      "Bash(python scripts/check_overlap.py *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(*gh issue *delete*)",
      "Bash(*gh issue *transfer*)",
      "Bash(*gh pr *merge*)",
      "Bash(*gh workflow *run*)"
    ],
    "deny": [
      "Bash(*gh release *)",
      "Bash(*--admin*)",
      "Bash(*--auto=*)",
      "Bash(*plan-approved*)",
      "Bash(*PLAN-APPROVED*)",
      "Bash(*Plan-Approved*)",
      "Bash(*Plan-approved*)",
      "Bash(*graphql*)",
      "Bash(*pending_deployments*)",
      "Bash(*deployments/*/statuses*)",
      "Bash(*deployment_protection_rule*)",
      "Bash(*approveDeployments*)",
      "Bash(*gh alias *)",
      "Bash(*gh auth token*)",
      "Bash(*gh api -X*)",
      "Bash(*gh api * -X*)",
      "Bash(*gh api -iX*)",
      "Bash(*gh api * -iX*)",
      "Bash(*gh api --method*)",
      "Bash(*gh api * --method*)",
      "Bash(*gh api -f*)",
      "Bash(*gh api * -f*)",
      "Bash(*gh api -if*)",
      "Bash(*gh api * -if*)",
      "Bash(*gh api -F*)",
      "Bash(*gh api * -F*)",
      "Bash(*gh api -iF*)",
      "Bash(*gh api * -iF*)",
      "Bash(*gh api --field*)",
      "Bash(*gh api * --field*)",
      "Bash(*gh api --raw-field*)",
      "Bash(*gh api * --raw-field*)",
      "Bash(*gh api --input*)",
      "Bash(*gh api * --input*)",
      "Bash(git push --tags*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.sh"
          }
        ]
      }
    ]
  }
}
